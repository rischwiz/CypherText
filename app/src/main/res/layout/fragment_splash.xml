<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.SplashFragment">

    <LinearLayout
        android:id="@+id/container"
        android:background="@color/secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_chat"
            android:layout_gravity="center"
            app:tint="@color/primary_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CypherText"
            android:fontFamily="@font/orbitron_variable_font"
            android:textSize="48sp"
            android:textColor="@color/primary"
            android:layout_gravity="center" />


    </LinearLayout>

    <TextView
        android:layout_marginBottom="30dp"
        android:layout_centerHorizontal="true"
        android:id="@+id/DevInfo"
        android:layout_alignParentBottom="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:text="Developed by Richard Schweizer"
        android:fontFamily="@font/vt_regular"
        android:textSize="18dp"/>
</RelativeLayout>