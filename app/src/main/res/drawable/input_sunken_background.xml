<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3D435C" /> <corners android:radius="17dp" />
        </shape>
    </item>

    <item android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1C1F2B" /> <corners android:radius="17dp" />
        </shape>
    </item>

    <item android:top="2dp" android:left="2dp" android:bottom="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#292D3E" /> <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>